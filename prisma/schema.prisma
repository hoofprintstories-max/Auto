generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ProjectStatus {
  DRAFT
  QUEUED
  GENERATING
  EDITING
  RENDERING
  COMPLETED
  FAILED
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  role            Role     @default(USER)
  credits         Int      @default(0)
  createdAt       DateTime @default(now())
  projects        Project[]
  subscriptions   Subscription[]
  usageEvents     ApiUsageEvent[]
}

model Subscription {
  id            String   @id @default(cuid())
  userId        String
  plan          String
  status        String
  renewsAt      DateTime?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
}

model Project {
  id                String        @id @default(cuid())
  userId            String
  title             String
  idea              String
  durationSec       Int
  language          String
  voiceStyle        String
  targetAudience    String
  tone              String
  visualStyle       String
  niche             String
  status            ProjectStatus @default(DRAFT)
  timelineJson      Json?
  renderUrl         String?
  thumbnailPrompt   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id])
  scenes            Scene[]
  jobs              RenderJob[]
}

model Scene {
  id                String   @id @default(cuid())
  projectId         String
  idx               Int
  startSec          Float
  endSec            Float
  narration         String
  visualInstruction String
  motionInstruction String
  textOverlay       String?
  sfxSuggestion     String?
  promptImage       String?
  promptVideo       String?
  promptBroll       String?
  project           Project  @relation(fields: [projectId], references: [id])
}

model RenderJob {
  id            String   @id @default(cuid())
  projectId     String
  queue         String
  status        String
  progress      Float    @default(0)
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id])
}

model ApiUsageEvent {
  id            String   @id @default(cuid())
  userId        String
  provider      String
  model         String
  tokensIn      Int      @default(0)
  tokensOut     Int      @default(0)
  costUsd       Float    @default(0)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
}
